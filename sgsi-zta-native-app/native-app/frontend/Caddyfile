:8080 {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }
    route {
        @private_paths path /docs /redoc /openapi.json /api/v1/docs /api/v1/redoc /api/v1/openapi.json /debug* /internal* /admin-api* /api/debug* /api/internal* /api/admin-api*
        respond @private_paths 404
        handle /api/* {
            reverse_proxy backend:8000
        }
        # Registered routes and intentional navigation placeholders only.
        # Dotted segments remain static requests, including under /assets.
        @spa {
            method GET HEAD
            path_regexp spa ^/(login|mfa(/setup)?|dashboard|users|assets(/[^/.]+(/edit)?)?|risks(/[^/.]+(/edit)?)?|controls(/[^/.]+(/edit)?)?|audit|settings|policies|alerts|events|evidence|clinical)?/?$
        }
        handle @spa {
            root * /srv
            rewrite * /index.html
            file_server
        }
        handle {
            root * /srv
            file_server
        }
    }
}
